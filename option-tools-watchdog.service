[Unit]
Description=Options Trading Watchdog
After=network.target

[Service]
Type=simple
User=vermes
WorkingDirectory=/home/vermes/option-tools
Environment=PATH=/home/vermes/option-tools/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/vermes/option-tools/venv/bin/python /home/vermes/option-tools/watchdog.py start --mode paper --interval 900 --foreground
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# Kill switch support
ExecStopPost=/bin/bash -c 'rm -f /home/vermes/option-tools/STOP'

# Resource limits
MemoryMax=500M
CPUQuota=50%

[Install]
WantedBy=multi-user.target